# Local/HOM: noindex por padrão. Não habilitar produção para revisar com a cliente.
PUBLIC_SITE_MODE=preview
PUBLIC_SITE_URL=https://julianecostapodologa.com.br
# Ao configurar HOM, informe sua origem HTTPS para previews de compartilhamento.
# PUBLIC_PREVIEW_URL=https://hom.example.com
# Player fica desligado até curadoria e comparação de desempenho.
PUBLIC_ENABLE_VIDEO=false
