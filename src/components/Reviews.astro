---
import { business } from '../data/site';
import { googleSnapshot, reviews } from '../data/reviews';
import Icon from './Icon.astro';
import Carousel from './Carousel.astro';
---

<section class="reviews-section section" aria-labelledby="reviews-title">
  <div class="shell">
    <div class="section-top">
      <div>
        <p class="eyebrow">QUEM JÁ FOI, CONTA</p>
        <h2 id="reviews-title" data-reveal>
          Cuidado que aparece
          <br />
          nas palavras de vocês.
        </h2>
      </div>
      <a class="google-rating" href={business.google} target="_blank" rel="noopener noreferrer">
        <span class="rating-number">
          {googleSnapshot.rating}
          <span class="stars" aria-hidden="true">
            ★★★★★
          </span>
        </span>
        <span>
          {googleSnapshot.count} avaliações no Google <Icon size={14} />
        </span>
      </a>
    </div>
    <Carousel id="avaliacoes-google" label="Avaliações de quem já foi atendido">
      {reviews.map((review) => (
        <figure class="review-card">
          <span class="quote-mark" aria-hidden="true">
            “
          </span>
          <blockquote>
            <p>
              {review.text}
              {review.excerpt && ' […]'}
            </p>
          </blockquote>
          <figcaption>
            <span class="review-initials" aria-hidden="true">
              {review.initials}
            </span>
            <div>
              <strong>{review.author}</strong>
              <span class="review-source">
                Google · {review.excerpt ? 'Trecho da avaliação' : 'Avaliação pública'}
              </span>
            </div>
          </figcaption>
        </figure>
      ))}
    </Carousel>
    <div class="review-footnote">
      <p>Avaliações selecionadas. Fonte: Google · conferido em {googleSnapshot.checked}.</p>
      <a href={business.google} target="_blank" rel="noopener noreferrer">
        Consultar todas as avaliações <Icon size={14} />
      </a>
    </div>
  </div>
</section>
