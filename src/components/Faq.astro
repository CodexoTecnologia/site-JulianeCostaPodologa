---
import Icon from './Icon.astro';
interface Props {
  items: ReadonlyArray<{ question: string; answer: string }>;
}
const { items } = Astro.props;
---

<div class="faq-list">
  {items.map((item) => (
    <details>
      <summary>
        <span>{item.question}</span>
        <Icon name="plus" />
      </summary>
      <div class="faq-answer">
        <p>{item.answer}</p>
      </div>
    </details>
  ))}
</div>
