---
import { navigation, whatsapp } from '../data/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand-link" href="/" aria-label="Juliane Costa Podóloga — início">
      <img
        src="/brand/juliane-signature.webp"
        width="320"
        height="205"
        alt="Juliane Costa Podóloga"
        fetchpriority="high"
      />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
      <span>Menu</span>
      <span class="menu-lines" aria-hidden="true"></span>
    </button>
    <nav id="main-nav" class="main-nav" aria-label="Navegação principal">
      {navigation.map((item) => (
        <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <a class="nav-contact" href={whatsapp()} target="_blank" rel="noopener noreferrer">
        <span>Agendar</span>
        <Icon name="whatsapp" size={18} />
      </a>
    </nav>
  </div>
</header>
