---
import Action from './Action.astro';
import Icon from './Icon.astro';
import { business, whatsapp } from '../data/site';
interface Props {
  title?: string;
  message?: string;
}
const { title = 'O próximo passo é uma conversa.', message } = Astro.props;
---

<section class="contact-section" id="agendar">
  <div class="shell contact-inner">
    <div>
      <p class="eyebrow">SEU MOMENTO DE CUIDADO</p>
      <h2 data-reveal>{title}</h2>
      <p>Conte o que você procura, tire suas dúvidas e consulte os horários disponíveis.</p>
      <Action href={whatsapp(message)} label="Conversar pelo WhatsApp" whatsapp external />
    </div>
    <div class="contact-address">
      <Icon name="pin" size={30} />
      <p>
        {business.address}
        <br />
        {business.neighborhood} · {business.city}, {business.state}
      </p>
      <span>{business.hours}</span>
      <a class="text-link" href="/localizacao/">
        Conheça o espaço <Icon size={15} />
      </a>
    </div>
  </div>
</section>
