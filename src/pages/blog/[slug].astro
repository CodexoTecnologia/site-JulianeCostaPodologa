---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';
import Icon from '../../components/Icon.astro';
import { publishedArticles, dateLabel } from '../../lib/articles';
export async function getStaticPaths() {
  return (await publishedArticles()).map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const data = article.data;
const href = `/blog/${article.id}/`;
---

<Base
  title={data.title}
  description={data.description}
  article={{ ...data, slug: article.id }}
  crumbs={[
    { name: 'Conteúdos', href: '/blog/' },
    { name: data.title, href },
  ]}
>
  <header class="page-hero article-hero">
    <p class="eyebrow">{data.category}</p>
    <h1>{data.title}</h1>
    <p class="lead">{data.description}</p>
    <div class="article-meta">
      <span>Por Equipe Codexo · conteúdo {data.editorial}</span>
      <time datetime={data.published}>{dateLabel(data.published)}</time>
      <span>{data.readingMinutes} min de leitura</span>
    </div>
  </header>
  <div class="shell article-layout">
    <article class="prose">
      <Content />
      <p class="article-footer-note">
        {data.editorial === 'educativo'
          ? 'Conteúdo educativo organizado pela Codexo com base nas referências indicadas. Não substitui avaliação, diagnóstico ou orientação individual de um profissional de saúde.'
          : 'Conteúdo institucional organizado pela Codexo a partir das informações do atendimento. Para orientações individuais e dúvidas sobre procedimentos, converse diretamente com a Juliane.'}
      </p>
    </article>
    <aside class="article-sidebar">
      <p class="eyebrow">CONTINUE POR AQUI</p>
      <h2>Seu próximo passo.</h2>
      <p>Conheça o atendimento relacionado e tire suas dúvidas com a Juliane.</p>
      <a href={data.service}>
        {data.serviceLabel} <Icon size={15} />
      </a>
      <br />
      <a href="/blog/">
        Todos os conteúdos <Icon size={15} />
      </a>
    </aside>
  </div>
  <Contact />
</Base>
