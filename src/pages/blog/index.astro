---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ArticleCards from '../../components/ArticleCards.astro';
import Contact from '../../components/Contact.astro';
---

<Base
  title="Conteúdos · Podologia, ILIB e sua primeira visita"
  description="Cuidados com os pés, unha encravada, calosidades, hidratação, diabetes e dúvidas sobre ILIB. Conteúdos da Juliane Costa Podóloga em Colombo, com fontes de referência."
  crumbs={[{ name: 'Conteúdos', href: '/blog/' }]}
>
  <PageHero
    eyebrow="UMA CONVERSA QUE CONTINUA"
    title="Para conhecer, entender e se preparar."
    description="Cuidados com os pés, dúvidas sobre as unhas e orientações para sua visita. Informação para entender melhor e conversar com quem cuida de você."
  />
  <section class="shell page-body" aria-label="Artigos">
    <ArticleCards />
  </section>
  <Contact />
</Base>
