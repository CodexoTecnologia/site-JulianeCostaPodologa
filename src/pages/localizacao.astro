---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Action from '../components/Action.astro';
import Contact from '../components/Contact.astro';
import Icon from '../components/Icon.astro';
import { business, whatsapp } from '../data/site';
import room from '../assets/studio_1.avif';
import details from '../assets/studio_3.avif';
import coffee from '../assets/studio_4.avif';
---

<Base
  title="Localização · Podóloga no Centro de Colombo"
  description="Juliane Costa Podóloga: Rua Venâncio Trevisan, 137, sala 01, Centro, Colombo — PR. Veja fotos, abra a rota e agende sua visita pelo WhatsApp."
  crumbs={[{ name: 'Localização', href: '/localizacao/' }]}
>
  <PageHero
    eyebrow="AQUI EM COLOMBO"
    title="Um espaço para receber você."
    description="No Centro da cidade, com um momento reservado para seu atendimento."
  />
  <section class="shell location-grid">
    <div>
      <h2>Venha conhecer.</h2>
      <p>
        {business.address}
        <br />
        {business.neighborhood} · {business.city}, {business.state}
        <br />
        CEP {business.postalCode}
      </p>
      <p>{business.hours}. Consulte a disponibilidade diretamente com a Juliane.</p>
      <div class="actions">
        <Action href={business.maps} label="Traçar minha rota" external />
        <a class="text-link" href={whatsapp()} target="_blank" rel="noopener noreferrer">
          Combinar minha visita <Icon size={16} />
        </a>
      </div>
    </div>
    <div class="map-card">
      <Icon name="pin" size={45} />
      <h3>Centro · Colombo, PR</h3>
      <p>Confira a rota a partir de onde você está e escolha como chegar.</p>
      <a class="text-link" href={business.maps} target="_blank" rel="noopener noreferrer">
        Abrir no Google Maps <Icon size={16} />
      </a>
    </div>
  </section>
  <section class="shell space-gallery" aria-label="Fotos do espaço de atendimento">
    <figure>
      <Image
        src={room}
        alt="Cadeira e bancada da sala de atendimento da Juliane"
        widths={[480, 800, 1200]}
        sizes="(max-width:800px) 90vw, 40vw"
        width={1100}
        format="webp"
        quality={82}
      />
      <figcaption>Seu espaço de cuidado.</figcaption>
    </figure>
    <figure>
      <Image
        src={details}
        alt="Detalhes da bancada e da cadeira do espaço da Juliane"
        widths={[360, 600, 900]}
        sizes="(max-width:800px) 45vw, 28vw"
        width={700}
        format="webp"
        quality={82}
      />
      <figcaption>Atenção aos detalhes.</figcaption>
    </figure>
    <figure>
      <Image
        src={coffee}
        alt="Cantinho do café preparado no espaço da Juliane"
        widths={[360, 600, 900]}
        sizes="(max-width:800px) 45vw, 28vw"
        width={700}
        format="webp"
        quality={82}
      />
      <figcaption>Uma pausa para receber você.</figcaption>
    </figure>
  </section>
  <div class="shell page-body">
    <aside class="info-note">
      Precisa de informações sobre acesso ao espaço ou ajuda para encontrar a sala? Converse com a
      Juliane antes da visita pelo{' '}
      <a href={whatsapp()} target="_blank" rel="noopener noreferrer">
        WhatsApp {business.phone}
      </a>
      .
    </aside>
  </div>
  <Contact />
</Base>
