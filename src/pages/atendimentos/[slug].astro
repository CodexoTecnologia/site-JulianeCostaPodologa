---
import { Image } from 'astro:assets';
import reflexologiaBanner from '../../assets/reflexologia-banner.png';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Action from '../../components/Action.astro';
import Faq from '../../components/Faq.astro';
import Contact from '../../components/Contact.astro';
import ServiceGallery from '../../components/ServiceGallery.astro';
import { services } from '../../data/services';
import { whatsapp } from '../../data/site';
export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const href = `/atendimentos/${service.slug}/`;
---

<Base
  title={`${service.short} em Colombo`}
  description={service.description}
  crumbs={[
    { name: 'Atendimentos', href: '/atendimentos/' },
    { name: service.short, href },
  ]}
>
  <PageHero eyebrow={service.eyebrow} title={service.title} description={service.description}>
    <div class="actions">
      <Action
        href={whatsapp(`Olá! Gostaria de conversar sobre ${service.short.toLowerCase()}.`)}
        label="Consultar horários pelo WhatsApp"
        whatsapp
        external
      />
    </div>
  </PageHero>
  <section class="shell content-grid page-body">
    <div>
      <h2>{service.leadTitle}</h2>
      {service.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <div>
      <p class="eyebrow">O QUE VOCÊ ENCONTRA</p>
      <ul>
        {service.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <aside class="info-note">{service.note}</aside>
    </div>
  </section>
  <section class="shell service-details" aria-label="Mais sobre o atendimento">
    {service.sections.map((section) => (
      <article id={section.id}>
        <h2>{section.title}</h2>
        <p>{section.body}</p>
      </article>
    ))}
    {service.slug === 'cuidados-com-os-pes' && (
      <article class="service-media">
        <h2>Conheça um atendimento de podologia.</h2>
        <p>Veja um registro de antes e depois. Cada atendimento é individual e os resultados podem variar.</p>
        <div data-podologia-video>
          <a class="text-link" href="/media/podologia-antes-depois.mp4" data-play-podologia>Assistir ao vídeo de podologia</a>
        </div>
      </article>
    )}
    {service.slug === 'bem-estar' && (
      <article class="service-media">
        <h2>Conheça a reflexologia podal.</h2>
        <p>A imagem apresenta um mapa tradicional da reflexologia. Essas associações não estabelecem diagnóstico nem comprovam tratamento de órgãos.</p>
        <Image src={reflexologiaBanner} alt="Mapa ilustrativo de reflexologia podal presente no material da Juliane" widths={[640, 960, 1280]} sizes="(max-width: 800px) 90vw, 900px" width={1280} format="webp" quality={80} loading="lazy" />
      </article>
    )}
    {service.slug === 'bem-estar' && <ServiceGallery kinds={['spa', 'reflexologia', 'reiki']} />}
  </section>
  <section class="section shell faq-preview" style="border-top:1px solid var(--line)">
    <div>
      <p class="eyebrow">ANTES DA VISITA</p>
      <h2>
        Dúvidas sobre
        <br />
        este cuidado.
      </h2>
    </div>
    <Faq items={service.faqs} />
  </section>
  <Contact />
</Base>
<style>
  .service-details {
    padding-bottom: 64px;
  }
  .service-details article {
    padding: 32px 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(var(--header) + 24px);
  }
  .service-details article h2 {
    font-size: clamp(28px, 3vw, 38px);
    max-width: 850px;
  }
  .service-details article p {
    max-width: 780px;
    margin-top: 18px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-podologia-video]').forEach((container) => {
    const link = container.querySelector<HTMLAnchorElement>('[data-play-podologia]');
    link?.addEventListener('click', (event) => {
      event.preventDefault();
      const video = document.createElement('video');
      video.controls = true;
      video.playsInline = true;
      video.preload = 'none';
      video.src = link.href;
      video.setAttribute('aria-label', 'Vídeo de antes e depois de podologia');
      video.style.cssText = 'display:block;width:min(100%,420px);max-height:70vh;margin-top:20px;border-radius:20px;background:#231c27';
      link.replaceWith(video);
      video.focus();
      void video.play().catch(() => {});
    });
  });
</script>
